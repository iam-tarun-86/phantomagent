# PhantomAgent configuration — copy to .env and edit. .env is gitignored.
# The backend reads these from the process environment; start.sh forwards them through sudo.

# ===== Authentication (required for anything beyond a local demo) =====

# Shared bearer token for every /api route and the WebSocket.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a new token is generated on each boot and printed to the console.
PHANTOM_API_TOKEN=

# Operator login for the dashboard.
PHANTOM_USER=admin

# PBKDF2-SHA256 password hash, formatted "<hex_salt>$<hex_hash>".
# Generate: PYTHONPATH=. backend/venv/bin/python -c \
#   "from backend.config import hash_password; print(hash_password('your-password'))"
# If unset, the dev fallback password is accepted and a warning is printed at boot.
PHANTOM_PASSWORD_HASH=

# ===== Network exposure =====

# Defaults to loopback. This API approves containment actions that run with sudo —
# only widen this on a network you control.
PHANTOM_HOST=127.0.0.1
PHANTOM_PORT=8000

# Comma-separated browser origins permitted to call the API.
PHANTOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Behaviour =====

# Seconds an operator has to answer a critical alert before it auto-contains.
PHANTOM_APPROVAL_TIMEOUT=15

# Exposes /api/test/inject* which emit fabricated threats. Turn off outside demos.
PHANTOM_DEMO_MODE=true
